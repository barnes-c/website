{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        ":semanticCommits",
        "helpers:pinGitHubActionDigests"
    ],
    "labels": [
        "dependencies"
    ],
    "pinDigests": true,
    "packageRules": [
        {
            "matchUpdateTypes": [
                "patch"
            ],
            "automerge": true,
            "minimumReleaseAge": "3 days"
        },
        {
            "matchManagers": [
                "bun",
                "npm"
            ],
            "matchDepTypes": [
                "devDependencies"
            ],
            "groupName": "dev dependencies"
        },
        {
            "matchManagers": [
                "github-actions"
            ],
            "groupName": "github actions"
        },
        {
            "matchManagers": [
                "dockerfile"
            ],
            "groupName": "docker base images"
        },
        {
            "description": "Types must match the Node runtime in the Dockerfile (node:24-alpine).",
            "matchPackageNames": [
                "@types/node"
            ],
            "allowedVersions": "<25"
        },
        {
            "description": "TypeScript majors need typescript-eslint and Next.js support first; open only on request.",
            "matchPackageNames": [
                "typescript"
            ],
            "matchUpdateTypes": [
                "major"
            ],
            "dependencyDashboardApproval": true
        }
    ]
}
